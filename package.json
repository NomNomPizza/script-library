{
  "build": {
    "afterPack": "./build/afterPack.js",
    "appId": "com.electron.script-library",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "zip"
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false
    },
    "productName": "Script Library",
    "publish": [
      {
        "owner": "NomNomPizza",
        "provider": "github",
        "repo": "script-library"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "description": "Script Library - a script writing app with an Eagle-style library folder that syncs through Google Drive.",
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "^26.0.12"
  },
  "main": "main.js",
  "name": "script-library",
  "private": true,
  "scripts": {
    "dist": "electron-builder -mw",
    "dist-mac": "electron-builder --mac",
    "dist-win": "electron-builder --win",
    "release": "electron-builder -mw --publish always",
    "start": "electron ."
  },
  "version": "1.3.1"
}
